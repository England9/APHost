---
import Button from '../ui/Button.astro';
import SectionLabel from '../ui/SectionLabel.astro';
---

<section class="relative min-h-[92vh] overflow-hidden border-b hairline" aria-labelledby="hero-heading">
  <div class="absolute inset-0">
    <div
      class="absolute inset-0 bg-[linear-gradient(135deg,#0a0a0a_0%,#141210_45%,#0d0c0b_100%)]"
      aria-hidden="true"
    ></div>
    <div
      class="absolute inset-y-0 right-0 w-full max-w-[58%] opacity-40 md:opacity-100"
      aria-hidden="true"
    >
      <img
        src="/images/hero-editorial.jpg"
        alt=""
        class="h-full w-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
        width="1200"
        height="1600"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-canvas)] via-[color-mix(in_srgb,var(--color-canvas)_55%,transparent)] to-transparent"></div>
    </div>
  </div>

  <div class="content-wrap relative z-10 flex min-h-[92vh] flex-col justify-end px-[var(--spacing-content)] pb-20 pt-36 md:pb-28 md:pt-40">
    <div class="max-w-3xl reveal">
      <SectionLabel label="Apollo Twelve LLC" class="mb-8" />
      <h1
        id="hero-heading"
        class="font-serif text-[clamp(2.75rem,7vw,4.75rem)] leading-[1.08] text-[var(--color-ink)]"
      >
        Building Distinct Ventures Under a Shared Direction.
      </h1>
      <p class="mt-8 max-w-xl text-[1.0625rem] leading-relaxed text-[var(--color-ink-muted)] md:text-[1.125rem]">
        Apollo is the public-facing platform for Apollo Twelve LLC — building a focused group of ventures across lifestyle, culture, and long-term brand development.
      </p>
      <div class="mt-12">
        <Button href="#ventures">View the Organizations</Button>
      </div>
    </div>
  </div>
</section>
