---
---

<section id="about" class="relative min-h-[92vh] overflow-hidden border-b hairline" aria-labelledby="hero-heading">
  <div class="absolute inset-0 bg-[var(--color-canvas)]" aria-hidden="true"></div>

  <div
    class="absolute inset-y-0 right-0 w-full max-w-[52%] opacity-50 md:opacity-100"
    aria-hidden="true"
  >
    <img
      src="/images/hero-editorial.jpg"
      alt=""
      class="h-full w-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
      width="1200"
      height="1600"
    />
    <div
      class="absolute inset-0 bg-gradient-to-r from-[var(--color-canvas)] via-[color-mix(in_srgb,var(--color-canvas)_45%,transparent)] to-transparent"
    ></div>
  </div>

  <div class="content-wrap-wide relative z-10 flex min-h-[92vh] flex-col justify-center px-[var(--spacing-content)] pb-20 pt-36 md:pb-28 md:pt-40">
    <div class="max-w-2xl reveal">
      <p class="label-caps mb-6">Apollo Twelve LLC</p>
      <h1
        id="hero-heading"
        class="font-serif text-[clamp(2.5rem,6vw,4.25rem)] leading-[1.08] text-[var(--color-ink)]"
      >
        Building Distinct Ventures Under a Shared Direction.
      </h1>
      <div class="my-8 h-px w-14 bg-[var(--color-gold)]" aria-hidden="true"></div>
      <p class="max-w-lg text-[1rem] leading-relaxed text-[var(--color-ink-muted)] md:text-[1.0625rem]">
        Apollo Twelve is the public-facing platform for a focused group of ventures across lifestyle, culture, and long-term brand development.
      </p>
      <div class="mt-10">
        <a
          href="#ventures"
          class="inline-flex items-center gap-3 font-sans text-[0.75rem] font-medium tracking-[0.1em] uppercase text-[var(--color-ink)] transition-colors hover:text-[var(--color-gold)]"
        >
          Explore the Ventures
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
