---
import { inquiryOptions, site } from '../../data/site';
import SectionLabel from '../ui/SectionLabel.astro';
---

<section id="contact" class="section-pad border-t hairline" aria-labelledby="contact-heading">
  <div class="content-wrap-wide">
    <div class="grid gap-16 lg:grid-cols-[0.85fr_1.15fr] lg:gap-24">
      <div>
        <SectionLabel label="Contact" />
        <h2
          id="contact-heading"
          class="mt-6 font-serif text-[clamp(2rem,4vw,3rem)] leading-[1.05] text-[var(--color-ink)]"
        >
          Inquiries
        </h2>
        <p class="mt-6 max-w-md text-[0.9375rem] leading-relaxed text-[var(--color-ink-muted)]">
          For business inquiries, partnerships, press, organization-specific correspondence, or general questions, please use the secure form below.
        </p>

        <ul class="mt-10 space-y-2 text-[0.8125rem] text-[var(--color-ink-faint)]">
          <li>Business inquiries</li>
          <li>Partnerships</li>
          <li>Press</li>
          <li>Organization-specific inquiries</li>
          <li>General correspondence</li>
          <li>Privacy and legal requests</li>
        </ul>
      </div>

      <form
        id="contact-form"
        class="space-y-6 border hairline bg-[var(--color-canvas-raised)] p-8 md:p-10"
        novalidate
      >
        <div class="grid gap-6 md:grid-cols-2">
          <div class="space-y-2">
            <label for="name" class="label-caps">Name</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              autocomplete="name"
              class="w-full border-b hairline bg-transparent px-0 py-3 text-[0.9375rem] text-[var(--color-ink)] outline-none transition-colors focus:border-[var(--color-gold)]"
            />
          </div>
          <div class="space-y-2">
            <label for="email" class="label-caps">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="w-full border-b hairline bg-transparent px-0 py-3 text-[0.9375rem] text-[var(--color-ink)] outline-none transition-colors focus:border-[var(--color-gold)]"
            />
          </div>
        </div>

        <div class="space-y-2">
          <label for="company" class="label-caps">Company or Organization</label>
          <input
            id="company"
            name="company"
            type="text"
            autocomplete="organization"
            class="w-full border-b hairline bg-transparent px-0 py-3 text-[0.9375rem] text-[var(--color-ink)] outline-none transition-colors focus:border-[var(--color-gold)]"
          />
        </div>

        <div class="space-y-2">
          <label for="interest" class="label-caps">Area of Interest</label>
          <select
            id="interest"
            name="interest"
            required
            class="w-full appearance-none border-b hairline bg-transparent px-0 py-3 text-[0.9375rem] text-[var(--color-ink)] outline-none transition-colors focus:border-[var(--color-gold)]"
          >
            {
              inquiryOptions.map((option) => (
                <option value={option} class="bg-[var(--color-canvas-raised)]">
                  {option}
                </option>
              ))
            }
          </select>
        </div>

        <div class="space-y-2">
          <label for="message" class="label-caps">Message</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="w-full resize-y border hairline bg-[var(--color-canvas)] px-4 py-3 text-[0.9375rem] leading-relaxed text-[var(--color-ink)] outline-none transition-colors focus:border-[var(--color-gold)]"
          ></textarea>
        </div>

        <div
          class="cf-turnstile min-h-[65px]"
          data-sitekey={site.turnstileSiteKey}
          data-theme="dark"
          data-callback="onTurnstileVerified"
          data-expired-callback="onTurnstileExpired"
          data-error-callback="onTurnstileError"
        ></div>

        <p id="form-status" class="hidden text-[0.875rem]" role="status" aria-live="polite"></p>

        <button
          type="submit"
          id="contact-submit"
          class="border border-[var(--color-line)] px-7 py-3.5 font-sans text-[0.8125rem] font-medium tracking-[0.04em] uppercase text-[var(--color-ink)] transition-colors hover:border-[var(--color-gold)] hover:text-[var(--color-gold)] disabled:cursor-not-allowed disabled:opacity-50"
        >
          Send Inquiry
        </button>
      </form>
    </div>
  </div>
</section>

<script is:inline>
  window.turnstileReady = false;

  window.onTurnstileVerified = function () {
    window.turnstileReady = true;
    const submitButton = document.getElementById('contact-submit');
    if (submitButton) submitButton.disabled = false;
  };

  window.onTurnstileExpired = function () {
    window.turnstileReady = false;
    const submitButton = document.getElementById('contact-submit');
    if (submitButton) submitButton.disabled = true;
    const status = document.getElementById('form-status');
    if (status) {
      status.textContent = 'Security verification expired. Please verify again.';
      status.classList.remove('hidden');
      status.classList.add('text-[var(--color-burgundy)]');
    }
  };

  window.onTurnstileError = function () {
    window.turnstileReady = false;
    const submitButton = document.getElementById('contact-submit');
    if (submitButton) submitButton.disabled = true;
    const status = document.getElementById('form-status');
    if (status) {
      status.textContent =
        'Security verification could not load. Check that apollotwelve.org is added to your Turnstile widget hostnames, then refresh.';
      status.classList.remove('hidden');
      status.classList.add('text-[var(--color-burgundy)]');
    }
  };
</script>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const submitButton = document.getElementById('contact-submit') as HTMLButtonElement | null;

  if (submitButton) submitButton.disabled = true;

  function setStatus(message: string, isError = false) {
    if (!status) return;
    status.textContent = message;
    status.classList.remove('hidden', 'text-[var(--color-gold)]', 'text-[var(--color-burgundy)]');
    status.classList.add(isError ? 'text-[var(--color-burgundy)]' : 'text-[var(--color-gold)]');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !submitButton) return;

    const formData = new FormData(form);
    const turnstileToken = (form.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement | null)?.value;

    if (!turnstileToken || !window.turnstileReady) {
      setStatus('Please complete the security verification below.', true);
      return;
    }

    submitButton.disabled = true;
    setStatus('Sending...');

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          name: formData.get('name'),
          email: formData.get('email'),
          company: formData.get('company'),
          interest: formData.get('interest'),
          message: formData.get('message'),
          turnstileToken,
        }),
      });

      const result = (await response.json()) as { success?: boolean; error?: string };

      if (!response.ok || !result.success) {
        throw new Error(result.error ?? 'Unable to send your message.');
      }

      form.reset();
      window.turnstileReady = false;
      if (window.turnstile) {
        window.turnstile.reset();
      }
      submitButton.disabled = true;
      setStatus('Thank you. Your inquiry has been sent.');
    } catch (error) {
      setStatus(error instanceof Error ? error.message : 'Unable to send your message.', true);
      submitButton.disabled = !window.turnstileReady;
    }
  });
</script>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  declare global {
    interface Window {
      turnstileReady: boolean;
      turnstile?: {
        reset: (widgetId?: string) => void;
      };
      onTurnstileVerified?: () => void;
      onTurnstileExpired?: () => void;
      onTurnstileError?: () => void;
    }
  }
</script>
