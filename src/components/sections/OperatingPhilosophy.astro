---
import SectionLabel from '../ui/SectionLabel.astro';
---

<section class="section-pad border-t hairline" aria-labelledby="philosophy-heading">
  <div class="content-wrap-narrow text-center">
    <SectionLabel label="Operating Philosophy" class="mb-8" />
    <h2
      id="philosophy-heading"
      class="font-serif text-[clamp(2.25rem,5vw,4rem)] leading-[1.05] tracking-[-0.02em] text-[var(--color-ink)]"
    >
      Built with Long-Term Intent.
    </h2>
    <p class="mx-auto mt-10 max-w-2xl text-[1.0625rem] leading-[1.8] text-[var(--color-ink-muted)] md:text-[1.125rem]">
      The organizations connected through Vulcira are developed with a long-term perspective. Each venture is approached as an independent identity, supported by disciplined planning, thoughtful design, and a commitment to durable value.
    </p>
  </div>
</section>
