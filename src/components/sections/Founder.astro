---
import SectionLabel from '../ui/SectionLabel.astro';
---

<section class="section-pad border-t hairline bg-[var(--color-canvas-raised)]" aria-labelledby="founder-heading">
  <div class="content-wrap-wide">
    <div class="grid items-start gap-10 md:grid-cols-[200px_1fr] md:gap-16 lg:grid-cols-[240px_1fr]">
      <figure class="mx-auto w-full max-w-[200px] md:mx-0">
        <div class="aspect-[3/4] overflow-hidden border hairline bg-[var(--color-canvas-subtle)]">
          <img
            src="/images/founder-portrait.svg"
            alt="Founder portrait placeholder — replace with approved photography"
            class="h-full w-full object-cover grayscale"
            loading="lazy"
            width="480"
            height="640"
          />
        </div>
        <figcaption class="mt-3 text-center text-[0.75rem] text-[var(--color-ink-faint)] md:text-left">
          Portrait placeholder
        </figcaption>
      </figure>

      <div class="max-w-2xl">
        <SectionLabel label="Leadership" />
        <h2
          id="founder-heading"
          class="mt-6 font-serif text-[clamp(1.75rem,3vw,2.5rem)] leading-[1.1] text-[var(--color-ink)]"
        >
          Shared Leadership
        </h2>
        <p class="mt-6 text-[1.0625rem] leading-[1.75] text-[var(--color-ink-muted)]">
          The ventures connected through Vulcira reflect a shared approach to development, responsibility, and long-term direction — built with discipline and a commitment to work that endures.
        </p>
        <div class="mt-8 border-l-2 border-[var(--color-gold)]/40 pl-6">
          <p class="text-[0.9375rem] leading-relaxed text-[var(--color-ink-faint)]">
            Founder biography to be added. Name, credentials, and personal history will be provided and inserted here.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
