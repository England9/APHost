---
import SectionLabel from '../ui/SectionLabel.astro';
import { site } from '../../data/site';
---

<section class="section-pad border-t hairline bg-[var(--color-canvas-raised)]" aria-labelledby="founder-heading">
  <div class="content-wrap-wide">
    <div class="grid items-center gap-12 md:grid-cols-[280px_1fr] md:gap-20 lg:grid-cols-[320px_1fr] lg:gap-24">
      <figure class="mx-auto w-full max-w-[280px] md:mx-0 lg:max-w-[320px]">
        <div class="aspect-[3/4] overflow-hidden border hairline bg-[var(--color-canvas-subtle)]">
          <img
            src="/images/founder-portrait.jpeg"
            alt={`${site.founder.displayName}, ${site.founder.title} — overlooking the Miami skyline`}
            class="h-full w-full object-cover"
            loading="lazy"
            width="640"
            height="853"
          />
        </div>
      </figure>

      <div class="max-w-3xl">
        <SectionLabel label="Leadership" />
        <h2
          id="founder-heading"
          class="mt-6 font-serif text-[clamp(2rem,3.5vw,3rem)] leading-[1.08] text-[var(--color-ink)]"
        >
          {site.founder.displayName}
        </h2>
        <p class="mt-3 text-[0.9375rem] font-medium tracking-[0.06em] uppercase text-[var(--color-ink-muted)]">
          {site.founder.title}
        </p>
        <p class="mt-8 text-[1.125rem] leading-[1.8] text-[var(--color-ink-muted)] md:text-[1.1875rem]">
          England founded the ventures connected through Apollo Twelve and The Chain Reaction Project. His work reflects a shared approach to development, responsibility, and long-term direction — built with discipline and a commitment to organizations that endure.
        </p>
      </div>
    </div>
  </div>
</section>
