---
import { getNonprofit } from '../../data/organizations';
import SectionLabel from '../ui/SectionLabel.astro';
import Button from '../ui/Button.astro';

const nonprofit = getNonprofit();
---

{
  nonprofit && (
    <section
      id="nonprofit"
      class="section-pad border-y hairline bg-[var(--color-canvas-subtle)]"
      aria-labelledby="nonprofit-heading"
    >
      <div class="content-wrap-wide">
        <div class="grid items-start gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20">
          <div class="lg:pt-4">
            <SectionLabel label="Separate Entity" />
            <h2
              id="nonprofit-heading"
              class="mt-6 font-serif text-[clamp(2rem,4vw,3.25rem)] leading-[1.05] text-[var(--color-ink)]"
            >
              Independent Nonprofit
            </h2>
            <p class="mt-4 text-[0.8125rem] uppercase tracking-[0.12em] text-[var(--color-burgundy)]">
              Not associated with Apollo Twelve LLC
            </p>
          </div>

          <div class="space-y-8 border-l border-[var(--color-burgundy)]/30 pl-8 lg:pl-12">
            <h3 class="font-serif text-[1.75rem] text-[var(--color-ink)]">{nonprofit.name}</h3>
            <p class="max-w-2xl text-[1.0625rem] leading-[1.75] text-[var(--color-ink-muted)]">
              {nonprofit.shortDescription}
            </p>
            <p class="max-w-xl text-[0.9375rem] leading-relaxed text-[var(--color-ink-faint)]">
              {nonprofit.legalRelationship}
            </p>
            <Button href="#contact">{nonprofit.actionLabel}</Button>
          </div>
        </div>
      </div>
    </section>
  )
}
