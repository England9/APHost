---
import { getHomepageVentures } from '../../data/organizations';
import VentureCard from '../ui/VentureCard.astro';

const ventures = getHomepageVentures().filter((org) => org.category !== 'nonprofit');

const ventureMeta = [
  { slug: 'vulcira', index: '01', eyebrow: 'Lifestyle Brand' },
  { slug: 'golden-days', index: '02', eyebrow: 'Vintage Fashion' },
  { slug: 'apollo-twelve-consulting', index: '03', eyebrow: 'Business Advisory' },
]
  .map(({ slug, index, eyebrow }) => {
    const org = ventures.find((item) => item.id === slug);
    return org ? { org, index, eyebrow } : null;
  })
  .filter(Boolean);
---

<section id="ventures" class="section-pad border-t hairline" aria-labelledby="ventures-heading">
  <div class="content-wrap-wide space-y-14 md:space-y-16">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="label-caps">Our Ventures</p>
        <h2
          id="ventures-heading"
          class="mt-4 font-serif text-[clamp(2rem,4vw,3rem)] leading-[1.12] text-[var(--color-ink)]"
        >
          Three ventures. Shared standard for quality.
        </h2>
        <p class="mt-5 max-w-xl text-[0.9375rem] leading-relaxed text-[var(--color-ink-muted)]">
          Vulcira, Golden Days, and Apollo Twelve Consulting are the commercial ventures under Apollo Twelve LLC. Each serves a different market. All are held to the same bar for product, service, and execution.
        </p>
      </div>
      <a
        href="/ventures/vulcira"
        class="inline-flex shrink-0 items-center gap-2 self-start font-sans text-[0.6875rem] font-medium tracking-[0.1em] uppercase text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)] lg:self-auto"
      >
        View All Ventures
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      {
        ventureMeta.map((item) =>
          item ? (
            <VentureCard
              index={item.index}
              eyebrow={item.eyebrow}
              name={item.org.name}
              description={item.org.shortDescription}
              href={item.org.pagePath}
              actionLabel={item.org.actionLabel}
              image={item.org.image}
              imageAlt={item.org.imageAlt}
            />
          ) : null,
        )
      }
    </div>
  </div>
</section>
