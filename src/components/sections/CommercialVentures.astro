---
import { getHomepageVentures } from '../../data/organizations';
import SectionLabel from '../ui/SectionLabel.astro';
import VentureCard from '../ui/VentureCard.astro';

const ventures = getHomepageVentures();
const [vulcira, goldenDays, chainReaction] = ventures;
---

<section id="ventures" class="section-pad" aria-labelledby="ventures-heading">
  <div class="content-wrap-wide space-y-16 md:space-y-20">
    <div class="max-w-2xl">
      <SectionLabel label="Our Ventures" />
      <h2
        id="ventures-heading"
        class="mt-6 font-serif text-[clamp(2rem,4vw,3.25rem)] leading-[1.12] text-[var(--color-ink)]"
      >
        Three distinct directions. One shared standard.
      </h2>
      <p class="mt-6 text-[1.0625rem] leading-relaxed text-[var(--color-ink-muted)]">
        From lifestyle and culture to nostalgic experiences to generous nonprofit work — each venture is developed with intention and its own voice.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3 lg:gap-10">
      {
        vulcira && (
          <VentureCard
            eyebrow="Lifestyle Brand"
            name={vulcira.name}
            description={vulcira.shortDescription}
            href={vulcira.pagePath}
            actionLabel={vulcira.actionLabel}
            image={vulcira.image}
            imageAlt={vulcira.imageAlt}
          />
        )
      }
      {
        goldenDays && (
          <VentureCard
            eyebrow="Nostalgia & Youth"
            name={goldenDays.name}
            description={goldenDays.shortDescription}
            href={goldenDays.pagePath}
            actionLabel={goldenDays.actionLabel}
            image={goldenDays.image}
            imageAlt={goldenDays.imageAlt}
          />
        )
      }
      {
        chainReaction && (
          <VentureCard
            eyebrow="Nonprofit"
            name={chainReaction.name}
            description={chainReaction.shortDescription}
            href={chainReaction.pagePath}
            actionLabel={chainReaction.actionLabel}
            image={chainReaction.image}
            imageAlt={chainReaction.imageAlt}
          />
        )
      }
    </div>
  </div>
</section>
