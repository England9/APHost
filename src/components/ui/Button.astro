---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { href, variant = 'primary', class: className = '' } = Astro.props;

const base =
  'inline-flex items-center justify-center font-sans text-[0.8125rem] font-medium tracking-[0.04em] uppercase transition-colors duration-200';

const variants = {
  primary:
    'border border-[var(--color-line)] px-7 py-3.5 text-[var(--color-ink)] hover:border-[var(--color-gold)] hover:text-[var(--color-gold)]',
  secondary:
    'border-b border-[var(--color-ink-muted)] pb-1 text-[var(--color-ink-muted)] hover:border-[var(--color-ink)] hover:text-[var(--color-ink)]',
};
---

<a href={href} class:list={[base, variants[variant], className]}>
  <slot />
</a>
