---
interface Props {
  index: string;
  eyebrow: string;
  name: string;
  description: string;
  href: string;
  actionLabel: string;
  image: string;
  imageAlt: string;
  id?: string;
}

const { index, eyebrow, name, description, href, actionLabel, image, imageAlt, id } = Astro.props;
---

<article id={id} class="group relative overflow-hidden border hairline bg-[var(--color-canvas-raised)]">
  <div class="aspect-[3/4] overflow-hidden">
    <img
      src={image}
      alt={imageAlt}
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
      loading="lazy"
      width="900"
      height="1200"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#000000] via-[color-mix(in_srgb,#000000_55%,transparent)] to-transparent"></div>
  </div>

  <div class="absolute inset-x-0 top-0 p-6 md:p-8">
    <span class="font-sans text-[0.8125rem] tracking-[0.08em] text-[var(--color-ink-faint)]">{index}</span>
  </div>

  <div class="absolute inset-x-0 bottom-0 p-6 md:p-8">
    <p class="mb-3 font-sans text-[0.6875rem] font-semibold tracking-[0.12em] uppercase text-[var(--color-gold)]">
      {eyebrow}
    </p>
    <h3 class="font-serif text-[clamp(1.5rem,3vw,2rem)] leading-[1.1] text-[var(--color-ink)]">{name}</h3>
    <p class="mt-3 max-w-xs text-[0.875rem] leading-relaxed text-[var(--color-ink-muted)]">
      {description}
    </p>
    <div class="mt-5">
      <a
        href={href}
        class="inline-flex items-center gap-2 font-sans text-[0.6875rem] font-medium tracking-[0.1em] uppercase text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
      >
        {actionLabel}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>
