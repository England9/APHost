---
import { navigation } from '../../data/site';
import Logo from '../ui/Logo.astro';
import MobileMenu from './MobileMenu.astro';
import VenturesDropdown from './VenturesDropdown.astro';
---

<header
  class="fixed inset-x-0 top-0 z-[90] bg-[color-mix(in_srgb,var(--color-canvas)_92%,transparent)] backdrop-blur-sm transition-[background-color] duration-300"
  data-header
>
  <div class="content-wrap-wide flex items-center justify-between gap-8 px-[var(--spacing-content)] py-5 md:py-6">
    <Logo showMark={true} />

    <nav class="hidden items-center gap-10 lg:flex" aria-label="Primary">
      <a
        href="/#about"
        class="font-sans text-[0.75rem] font-medium tracking-[0.1em] uppercase text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
        data-nav-link="about"
      >
        About
      </a>
      <VenturesDropdown />
      {
        navigation
          .filter((item) => item.label !== 'About')
          .map((item) => (
            <a
              href={item.href}
              class="font-sans text-[0.75rem] font-medium tracking-[0.1em] uppercase text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
              data-nav-link={item.label.toLowerCase()}
            >
              {item.label}
            </a>
          ))
      }
    </nav>

    <MobileMenu />
  </div>
  <div class="h-px bg-[var(--color-gold)]/30" aria-hidden="true"></div>
</header>

<script>
  const header = document.querySelector('[data-header]');

  function updateHeader() {
    if (!header) return;
    const scrolled = window.scrollY > 24;
    header.classList.toggle('bg-[color-mix(in_srgb,var(--color-canvas)_96%,transparent)]', scrolled);
  }

  function setActiveNav() {
    const links = document.querySelectorAll('[data-nav-link]');
    const hash = window.location.hash || '#about';
    links.forEach((link) => {
      const href = link.getAttribute('href') ?? '';
      const isActive = href === hash || (hash === '' && href === '/#about');
      link.classList.toggle('text-[var(--color-ink)]', isActive);
      link.classList.toggle('border-b', isActive);
      link.classList.toggle('border-[var(--color-gold)]', isActive);
      link.classList.toggle('pb-0.5', isActive);
    });
  }

  updateHeader();
  setActiveNav();
  window.addEventListener('scroll', updateHeader, { passive: true });
  window.addEventListener('hashchange', setActiveNav);
</script>
