---
import { site, navigation } from '../../data/site';
import MobileMenu from './MobileMenu.astro';

---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-300"
  data-header
>
  <div class="content-wrap flex items-center justify-between gap-8 px-[var(--spacing-content)] py-5 md:py-6">
    <a
      href="/"
      class="font-serif text-[1.375rem] tracking-[0.04em] text-[var(--color-ink)] md:text-[1.5rem]"
      aria-label={`${site.name} home`}
    >
      {site.name}
    </a>

    <nav class="hidden items-center gap-10 md:flex" aria-label="Primary">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class="link-underline font-sans text-[0.8125rem] font-medium tracking-[0.08em] uppercase text-[var(--color-ink-muted)] hover:text-[var(--color-ink)]"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <MobileMenu />
  </div>
</header>

<script>
  const header = document.querySelector('[data-header]');

  function updateHeader() {
    if (!header) return;
    const scrolled = window.scrollY > 24;
    header.classList.toggle('border-[var(--color-line)]', scrolled);
    header.classList.toggle('bg-[color-mix(in_srgb,var(--color-canvas)_88%,transparent)]', scrolled);
    header.classList.toggle('backdrop-blur-sm', scrolled);
  }

  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });
</script>
