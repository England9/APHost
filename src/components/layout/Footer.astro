---
import { site, navigation } from '../../data/site';
import { ventureNavLinks } from '../../data/venture-pages';

const year = new Date().getFullYear();
---

<footer class="border-t hairline bg-[var(--color-canvas-raised)]">
  <div class="content-wrap-wide section-pad !pb-12 !pt-16">
    <div class="grid gap-16 lg:grid-cols-[1.2fr_1fr_1fr]">
      <div class="max-w-md space-y-8">
        <p class="font-serif text-[1.75rem] tracking-[0.04em]">{site.name}</p>
        <div>
          <p class="label-caps mb-3">Commercial Group</p>
          <p class="font-serif text-[1.125rem] text-[var(--color-ink)]">{site.parentCompany}</p>
          <ul class="mt-4 space-y-2 text-[0.9375rem] text-[var(--color-ink-muted)]">
            {
              site.commercialGroup.map((name) => (
                <li>{name}</li>
              ))
            }
          </ul>
        </div>
      </div>

      <div>
        <p class="label-caps mb-6">Navigate</p>
        <ul class="space-y-3">
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="font-sans text-[0.9375rem] text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          {
            ventureNavLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="font-sans text-[0.9375rem] text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/privacy"
              class="font-sans text-[0.9375rem] text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
            >
              Privacy Policy
            </a>
          </li>
          <li>
            <a
              href="/terms"
              class="font-sans text-[0.9375rem] text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
            >
              Terms
            </a>
          </li>
        </ul>
      </div>

      <div>
        <p class="label-caps mb-6">Connect</p>
        <ul class="space-y-3">
          <li>
            <a
              href="/#contact"
              class="font-sans text-[0.9375rem] text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
            >
              Contact Form
            </a>
          </li>
          <li>
            <a
              href={site.social.linkedin}
              class="font-sans text-[0.9375rem] text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn
            </a>
          </li>
          <li>
            <a
              href={site.social.instagram}
              class="font-sans text-[0.9375rem] text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
              target="_blank"
              rel="noopener noreferrer"
            >
              Instagram
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-16 border-t hairline pt-8">
      <p class="text-[0.8125rem] text-[var(--color-ink-faint)]">
        &copy; {year} {site.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
