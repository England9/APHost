---
import { site, navigation } from '../../data/site';
import { ventureNavLinks } from '../../data/venture-pages';
import Logo from '../ui/Logo.astro';

const year = new Date().getFullYear();
const commercialVentures = ventureNavLinks.filter((link) => link.label !== site.initiative);
const initiativeLink = ventureNavLinks.find((link) => link.label === site.initiative);
---

<footer class="border-t hairline bg-[var(--color-canvas)]">
  <div class="content-wrap-wide section-pad !pb-10 !pt-16">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-5 lg:gap-10">
      <div class="space-y-6 sm:col-span-2 lg:col-span-1">
        <Logo linked={false} variant="footer" />
        <p class="max-w-xs text-[0.8125rem] leading-relaxed text-[var(--color-ink-faint)]">
          {site.footerDescription}
        </p>
      </div>

      <div>
        <p class="label-caps mb-5">Navigate</p>
        <ul class="space-y-2.5">
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="font-sans text-[0.8125rem] text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="label-caps mb-5">Ventures</p>
        <ul class="space-y-2.5">
          {
            commercialVentures.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="font-sans text-[0.8125rem] text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="label-caps mb-5">Initiative</p>
        <ul class="space-y-2.5">
          {
            initiativeLink && (
              <li>
                <a
                  href={initiativeLink.href}
                  class="font-sans text-[0.8125rem] text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
                >
                  {initiativeLink.label}
                </a>
              </li>
            )
          }
        </ul>
      </div>

      <div>
        <p class="label-caps mb-5">Connect</p>
        <ul class="space-y-2.5">
          <li>
            <a
              href="/#contact"
              class="font-sans text-[0.8125rem] text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
            >
              Contact Form
            </a>
          </li>
          <li>
            <a
              href={site.social.linkedin}
              class="font-sans text-[0.8125rem] text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn
            </a>
          </li>
          <li>
            <a
              href={site.social.instagram}
              class="font-sans text-[0.8125rem] text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
              target="_blank"
              rel="noopener noreferrer"
            >
              Instagram
            </a>
          </li>
          <li>
            <a
              href="/privacy"
              class="font-sans text-[0.8125rem] text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
            >
              Privacy Policy
            </a>
          </li>
          <li>
            <a
              href="/terms"
              class="font-sans text-[0.8125rem] text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
            >
              Terms
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 border-t hairline pt-8">
      <p class="text-[0.75rem] text-[var(--color-ink-faint)]">
        &copy; {year} {site.parentCompany}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
