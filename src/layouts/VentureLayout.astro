---
import BaseLayout from './BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import type { VenturePage } from '../data/venture-pages';

interface Props {
  venture: VenturePage;
}

const { venture } = Astro.props;
---

<BaseLayout
  title={`${venture.name} — Vulcira`}
  description={venture.intro}
>
  <article>
    <section class="border-b hairline pt-32 md:pt-40">
      <div class="content-wrap-wide section-pad !pt-0">
        <div class="grid items-end gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">
          <div class="max-w-2xl">
            <SectionLabel label={venture.eyebrow} />
            <h1 class="mt-6 font-serif text-[clamp(2.5rem,5vw,4.25rem)] leading-[1.02] tracking-[-0.03em] text-[var(--color-ink)]">
              {venture.title}
            </h1>
            <p class="mt-8 text-[1.0625rem] leading-[1.8] text-[var(--color-ink-muted)] md:text-[1.125rem]">
              {venture.intro}
            </p>
            <div class="mt-10">
              <Button href="/#contact" variant="secondary">Get in Touch</Button>
            </div>
          </div>

          <figure>
            <div class="aspect-[4/5] overflow-hidden border hairline bg-[var(--color-canvas-subtle)]">
              <img
                src={venture.image}
                alt={venture.imageAlt}
                class="h-full w-full object-cover"
                loading="eager"
                width="800"
                height="1000"
              />
            </div>
          </figure>
        </div>
      </div>
    </section>

    <section class="section-pad">
      <div class="content-wrap-wide space-y-20">
        {
          venture.sections.map((section, index) => (
            <div
              class:list={[
                'grid gap-8 border-t hairline pt-12 lg:grid-cols-[0.35fr_0.65fr] lg:gap-16 lg:pt-16',
                index % 2 === 1 && 'lg:[&>div:first-child]:order-2 lg:[&>div:last-child]:order-1',
              ]}
            >
              <div>
                <h2 class="font-serif text-[clamp(1.5rem,3vw,2.25rem)] leading-[1.1] text-[var(--color-ink)]">
                  {section.heading}
                </h2>
              </div>
              <p class="text-[1.0625rem] leading-[1.8] text-[var(--color-ink-muted)]">{section.body}</p>
            </div>
          ))
        }
      </div>
    </section>
  </article>
</BaseLayout>
