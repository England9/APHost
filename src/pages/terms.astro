---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalDocument from '../components/legal/LegalDocument.astro';
import { legalMeta } from '../data/legal/meta';
import { termsSections } from '../data/legal/terms';
---

<BaseLayout
  title="Terms of Use — Apollo"
  description="Terms of use for the Apollo website operated by Apollo Twelve LLC."
>
  <section class="section-pad">
    <div class="content-wrap-narrow">
      <LegalDocument
        title="Terms of Use"
        effectiveDate={legalMeta.effectiveDate}
        sections={termsSections}
        contactPath={legalMeta.contactPath}
      />
    </div>
  </section>
</BaseLayout>
