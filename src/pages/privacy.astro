---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalDocument from '../components/legal/LegalDocument.astro';
import { legalMeta } from '../data/legal/meta';
import { privacySections } from '../data/legal/privacy';
---

<BaseLayout
  title="Privacy Policy — Vulcira"
  description="Privacy policy for the Vulcira website operated by Apollo Twelve LLC."
>
  <section class="section-pad">
    <div class="content-wrap-narrow">
      <LegalDocument
        title="Privacy Policy"
        effectiveDate={legalMeta.effectiveDate}
        sections={privacySections}
        contactPath={legalMeta.contactPath}
      />
    </div>
  </section>
</BaseLayout>
